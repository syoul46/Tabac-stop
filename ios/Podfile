# Podfile de Cairn (jalon iOS-A, cf. PLAN.md §17).
#
# Il était jusqu'ici **régénéré à chaque build** depuis le template Flutter :
# ça marchait, mais rien ne le garantissait d'une image de runner à l'autre.
# Le voici versionné, avec deux écarts assumés vis-à-vis du template.

# Écart 1 — cible explicite, alignée sur IPHONEOS_DEPLOYMENT_TARGET du projet
# Xcode. Le template laisse cette ligne commentée ; on la fige pour que la
# version d'iOS visée ne dépende plus de ce que CocoaPods décide ce jour-là.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end

# ⚠️ Écart 2 RETIRÉ — mais pas pour la raison qu'on a d'abord cru.
#
# On avait ajouté ici le bloc `GCC_PREPROCESSOR_DEFINITIONS` documenté par
# permission_handler (toutes les permissions iOS à `0`, puisque Cairn n'en
# utilise aucune : `requestInstallPackages` est un chemin Android et les
# notifications passent par flutter_local_notifications).
#
# Deux runs consécutifs se sont bloqués avec ce bloc (test host d'integration_test
# figé sur le splash), et un run vert sans → on l'a accusé. **C'était faux** : le
# même blocage est revenu sans lui (run 31457923436). C'est un aléa du couple
# `flutter test` + simulateur, pas ce bloc. Cf. PLAN §17.4.
#
# Le bloc reste retiré — son bénéfice est marginal et on n'a aucune raison de le
# réintroduire — mais si quelqu'un veut le remettre, qu'il sache qu'il n'a jamais
# été prouvé coupable.
